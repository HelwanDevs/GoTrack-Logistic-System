        {
          "name": "Create Branch - Success",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Downtown Branch\",\n  \"location\": \"123 Main St\",\n  \"phone\": \"+201112345678\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/branches",
              "host": ["{{baseUrl}}"],
              "path": ["api", "branches"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('Has ID', () => {",
                  "  const json = pm.response.json();",
                  "  pm.expect(json.id).to.exist;",
                  "  pm.collectionVariables.set('branchId', json.id);",
                  "});",
                  "pm.test('Fields match', () => {",
                  "  const json = pm.response.json();",
                  "  pm.expect(json.name).to.eql('Downtown Branch');",
                  "  pm.expect(json.phone).to.eql('+201112345678');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
