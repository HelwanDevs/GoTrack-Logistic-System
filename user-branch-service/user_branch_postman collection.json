          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/users/profiles/search?name=john&type=EMPLOYEE&status=ACTIVE&branchId={{branchId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "users", "profiles", "search"],
              "query": [
                { "key": "name", "value": "john" },
                { "key": "type", "value": "EMPLOYEE" },
                { "key": "status", "value": "ACTIVE" },
                { "key": "branchId", "value": "{{branchId}}" }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('All filters applied', () => {",
                  "  const json = pm.response.json();",
                  "  json.content.forEach(profile => {",
                  "    pm.expect(profile.fullName.toLowerCase()).to.include('john');",
                  "    pm.expect(profile.type).to.eql('EMPLOYEE');",
                  "    pm.expect(profile.status).to.eql('ACTIVE');",
                  "    pm.expect(profile.branchId).to.eql(pm.collectionVariables.get('branchId'));",
                  "  });",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Integration Flow",
      "item": [
        {
          "name": "Full Workflow: Create Branch → Create Profile → Search → Update → Delete",
          "item": [
            {
              "name": "1. Create Test Branch",
              "request": {
                "method": "POST",
                "header": [{ "key": "Content-Type", "value": "application/json" }],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"name\": \"Integration Test Branch\",\n  \"location\": \"Test Location\",\n  \"phone\": \"+201001112222\"\n}"
                },
                "url": "{{baseUrl}}/api/branches"
              },
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "exec": [
                      "const json = pm.response.json();",
                      "pm.collectionVariables.set('branchId', json.id);"
                    ],
                    "type": "text/javascript"
                  }
                }
              ]
            },
            {
              "name": "2. Create Profile in Branch",
              "request": {
                "method": "POST",
                "header": [{ "key": "Content-Type", "value": "application/json" }],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"fullName\": \"Integration User\",\n  \"phoneNumber\": \"+201003334444\",\n  \"type\": \"EMPLOYEE\",\n  \"branchId\": {{branchId}},\n  \"accountId\": \"acc_integration\"\n}"
                },
                "url": "{{baseUrl}}/api/users/profiles"
              },
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "exec": [
                      "const json = pm.response.json();",
                      "pm.collectionVariables.set('profileId', json.data);"
                    ],
                    "type": "text/javascript"
                  }
                }
              ]
            },
            {
              "name": "3. Search Profile by Branch",
              "request": {
                "method": "GET",
                "url": "{{baseUrl}}/api/users/profiles/search?branchId={{branchId}}"
              },
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "exec": [
                      "pm.test('Profile appears in branch search', () => {",
                      "  const json = pm.response.json();",
                      "  const found = json.content.some(p => p.id == pm.collectionVariables.get('profileId'));",
                      "  pm.expect(found).to.be.true;",
                      "});"
                    ],
                    "type": "text/javascript"
                  }
                }
              ]
            },
            {
              "name": "4. Soft Delete Branch (Cascading check)",
              "request": {
                "method": "DELETE",
                "url": "{{baseUrl}}/api/branches/{{branchId}}"
              }
            },
            {
              "name": "5. Verify Profile Cannot Update with Deleted Branch",
              "request": {
                "method": "PUT",
                "header": [{ "key": "Content-Type", "value": "application/json" }],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"branchId\": {{branchId}}\n}"
                },
                "url": "{{baseUrl}}/api/users/profiles/{{profileId}}"
              },
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "exec": [
                      "pm.test('Cannot assign to deleted branch', () => {",
                      "  pm.response.to.have.status(409);",
                      "  const json = pm.response.json();",
                      "  pm.expect(json.message || json.error).to.include('deleted');",
                      "});"
                    ],
                    "type": "text/javascript"
                  }
                }
              ]
            }
          ]
        }
      ]
    }
  ]
}