          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "// First soft-delete the branch",
                  "const deleteReq = {",
                  "  url: pm.collectionVariables.get('baseUrl') + '/api/branches/' + pm.collectionVariables.get('branchId'),",
                  "  method: 'DELETE'",
                  "};",
                  "pm.sendRequest(deleteReq, () => {});"
                ],
                "type": "text/javascript"
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 400', () => pm.response.to.have.status(400));",
                  "pm.test('Cannot update deleted branch', () => {",
                  "  const json = pm.response.json();",
                  "  pm.expect(json.message || json.error).to.include('deleted');",
                  "});"
                ],
